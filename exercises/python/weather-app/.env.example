# Copy to .env and fill in. .env is gitignored; this file is committed.

# Required. Free key from https://openweathermap.org (API keys page).
OWM_API_KEY=your-api-key-here

# Units: imperial (°F, mph) or metric (°C, m/s). Default: imperial.
# Any other value also means imperial (with a warning in the server log).
UNITS=imperial

# Port for the dev server (`flask run` and `python main.py`). Default: 5000.
# On macOS, 5000 is also used by AirPlay Receiver; 5001 avoids the clash.
FLASK_RUN_PORT=5000
